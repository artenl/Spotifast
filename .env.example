# Copy to .env and fill in. Never commit .env.

# Sub-domain pointing at the VPS (DNS "A" record, plus "AAAA" if IPv6).
DOMAIN=musique.example.fr
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=toi@example.fr

TZ=Europe/Paris

# --- Limits (defaults shown) -----------------------------------------------
# Downloads running at the same time, for the whole server. Keep it low:
# bursts are what get a server's IP bot-checked by YouTube.
#SPOTIFAST_MAX_CONCURRENT_JOBS=2
#SPOTIFAST_MAX_ACTIVE_JOBS_PER_USER=1
#SPOTIFAST_MAX_TRACKS_PER_JOB=150
#SPOTIFAST_DAILY_TRACK_QUOTA=400
#SPOTIFAST_JOB_TIMEOUT_MIN=45
# Files are deleted from the server this long after a job ends...
#SPOTIFAST_RESULT_TTL_MIN=20
# ...or this long after the user downloaded them, whichever is sooner.
#SPOTIFAST_AFTER_DOWNLOAD_TTL_S=120
# Refuse new jobs below this much free disk.
#SPOTIFAST_MIN_FREE_DISK_MB=1500

# --- Sessions / login ---------------------------------------------------------
#SPOTIFAST_SESSION_IDLE_DAYS=7
#SPOTIFAST_SESSION_MAX_DAYS=30
#SPOTIFAST_LOGIN_MAX_FAILURES=5
#SPOTIFAST_LOGIN_WINDOW_MIN=15

# --- Container resources -------------------------------------------------------
#APP_MEM_LIMIT=2g
#APP_CPUS=2

# Optional outbound proxy for YouTube if the VPS IP gets bot-checked
# (passed through to Sunnify/yt-dlp).
#HTTPS_PROXY=http://user:pass@proxy.example:8080
